<Window x:Class="Resenha.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Resenha — Ajustes" Width="700" Height="760" MinWidth="620" MinHeight="620"
        WindowStartupLocation="CenterScreen" Icon="Assets/Resenha.ico">
    <Grid Margin="34">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="resenha." FontFamily="Georgia" FontSize="30" FontWeight="Bold" />
            <TextBlock Text="Sua voz, em qualquer campo." FontFamily="Georgia" FontSize="38"
                       FontWeight="Bold" Margin="0,20,0,6" />
            <TextBlock Text="Local, gratuito e sem conta. Segure o atalho, fale e solte."
                       Foreground="{StaticResource MutedInk}" FontSize="15" />
        </StackPanel>
        <Border Grid.Row="1" Height="1" Background="{StaticResource Rule}" Margin="0,28,0,22" />
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,12,0">
            <TextBlock Text="ATALHO GLOBAL" Foreground="{StaticResource Sage}" FontWeight="SemiBold" FontSize="11" />
            <Border Background="{StaticResource Paper}" BorderBrush="{StaticResource Rule}" BorderThickness="1"
                    CornerRadius="12" Padding="16" Margin="0,8,0,20">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <ComboBox ItemsSource="{Binding ShortcutChoices}" SelectedItem="{Binding SelectedShortcut}"
                              DisplayMemberPath="Label" AutomationProperties.Name="Atalho global" />
                    <Button Grid.Column="1" x:Name="CaptureButton" Content="Gravar atalho" Click="Capture_Click"
                            Margin="12,0,0,0" Background="{StaticResource Sage}" />
                </Grid>
            </Border>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="20" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="IDIOMA" Foreground="{StaticResource Sage}" FontWeight="SemiBold" FontSize="11" />
                    <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}"
                              Margin="0,8,0,0" AutomationProperties.Name="Idioma da transcrição" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <Grid>
                        <TextBlock Text="MICROFONE" Foreground="{StaticResource Sage}"
                                   FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                        <Button Content="Atualizar" Click="RefreshMicrophones_Click"
                                HorizontalAlignment="Right" Padding="10,3" FontSize="11"
                                Background="Transparent" Foreground="{StaticResource Ink}" />
                    </Grid>
                    <ComboBox ItemsSource="{Binding Microphones}" SelectedItem="{Binding SelectedMicrophone}"
                              DisplayMemberPath="DisplayName" Margin="0,8,0,0"
                              AutomationProperties.Name="Microfone" />
                    <TextBlock Text="{Binding MicrophoneNotice}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Foreground="{StaticResource MutedInk}" FontSize="12" />
                </StackPanel>
            </Grid>
            <Border Background="{StaticResource SageSoft}" CornerRadius="12" Padding="16" Margin="0,24,0,0">
                <StackPanel>
                    <TextBlock Text="Ditado local" FontWeight="Bold" FontSize="15" />
                    <TextBlock Text="O áudio nunca sai deste computador. Sem o JEV opcional, a transcrição também permanece local. O último texto fica apenas na memória e na área de transferência."
                               TextWrapping="Wrap" Margin="0,5,0,0" Foreground="{StaticResource MutedInk}" />
                </StackPanel>
            </Border>
            <TextBlock Text="JEV CONTEXTUAL — OPCIONAL" Foreground="{StaticResource Sage}"
                       FontWeight="SemiBold" FontSize="11" Margin="0,24,0,0" />
            <Border Background="{StaticResource Paper}" BorderBrush="{StaticResource Rule}"
                    BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,8,0,0">
                <StackPanel>
                    <CheckBox Content="Usar JEV para escolher palavras pelo contexto"
                              IsChecked="{Binding ContextualEnabled}" FontWeight="SemiBold" />
                    <TextBlock Text="O ditado local funciona sem esta opção. Quando ativada, somente a frase transcrita e alternativas do seu vocabulário são enviadas ao OpenRouter/TypeSafe — nunca áudio."
                               TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource MutedInk}" />
                    <TextBlock Text="Você usa sua própria chave. O OpenRouter pode cobrar diretamente sua conta; o Resenha não recebe nem subsidia esse valor."
                               TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource MutedInk}" />
                    <TextBlock Text="VOCABULÁRIO PESSOAL" Foreground="{StaticResource Sage}"
                               FontWeight="SemiBold" FontSize="11" Margin="0,16,0,0" />
                    <TextBox Text="{Binding PersonalVocabulary, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" MinHeight="62" MaxLength="4096" TextWrapping="Wrap"
                             Margin="0,6,0,0" AutomationProperties.Name="Vocabulário pessoal" />
                    <TextBlock Text="Uma palavra ou nome por linha. O JEV decide por contexto; nada vira substituição global."
                               TextWrapping="Wrap" Margin="0,5,0,0" Foreground="{StaticResource MutedInk}" FontSize="12" />
                    <TextBlock Text="CHAVE OPENROUTER" Foreground="{StaticResource Sage}"
                               FontWeight="SemiBold" FontSize="11" Margin="0,14,0,0" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <PasswordBox x:Name="OpenRouterKey" PasswordChanged="OpenRouterKey_PasswordChanged"
                                     MaxLength="256" AutomationProperties.Name="Chave pessoal do OpenRouter" />
                        <Button Grid.Column="1" Content="Revogar" Click="RevokeJev_Click" Margin="10,0,0,0"
                                Background="Transparent" Foreground="{StaticResource Ink}" />
                    </Grid>
                    <TextBlock Text="{Binding JevStatus}" Margin="0,7,0,0"
                               Foreground="{StaticResource MutedInk}" FontSize="12" />
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="3" Margin="0,24,0,0">
            <TextBlock Text="{Binding Notice}" VerticalAlignment="Center" Foreground="{StaticResource MutedInk}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Baixar modelo" Click="Download_Click" Margin="0,0,10,0"
                        Background="{StaticResource Sage}" />
                <Button Content="Limpar texto" Click="Clear_Click" Margin="0,0,10,0"
                        Background="Transparent" Foreground="{StaticResource Ink}" />
                <Button Content="Salvar ajustes" Click="Save_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>

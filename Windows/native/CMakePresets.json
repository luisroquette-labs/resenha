{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [{
    "name": "windows-x64-cpu",
    "displayName": "Pinned whisper.cpp, MSVC v143, x64 CPU only",
    "generator": "Visual Studio 17 2022",
    "architecture": "x64",
    "toolset": "v143",
    "binaryDir": "${sourceDir}/build/windows-x64-cpu",
    "cacheVariables": {
      "CMAKE_POLICY_DEFAULT_CMP0091": "NEW",
      "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>",
      "BUILD_SHARED_LIBS": "OFF",
      "GGML_STATIC": "ON",
      "GGML_NATIVE": "OFF",
      "GGML_CPU": "ON",
      "GGML_SSE42": "ON",
      "GGML_AVX": "ON",
      "GGML_AVX2": "ON",
      "GGML_BMI2": "OFF",
      "GGML_AVX_VNNI": "OFF",
      "GGML_AVX512": "OFF",
      "GGML_AVX512_VBMI": "OFF",
      "GGML_AVX512_VNNI": "OFF",
      "GGML_AVX512_BF16": "OFF",
      "GGML_BACKEND_DL": "OFF",
      "GGML_CPU_ALL_VARIANTS": "OFF",
      "GGML_CPU_HBM": "OFF",
      "GGML_CPU_KLEIDIAI": "OFF",
      "GGML_ACCELERATE": "OFF",
      "GGML_BLAS": "OFF",
      "GGML_LLAMAFILE": "OFF",
      "GGML_CUDA": "OFF",
      "GGML_MUSA": "OFF",
      "GGML_HIP": "OFF",
      "GGML_VULKAN": "OFF",
      "GGML_WEBGPU": "OFF",
      "GGML_METAL": "OFF",
      "GGML_OPENMP": "OFF",
      "GGML_RPC": "OFF",
      "GGML_SYCL": "OFF",
      "GGML_OPENCL": "OFF",
      "GGML_ZDNN": "OFF",
      "GGML_CCACHE": "OFF",
      "GGML_BUILD_TESTS": "OFF",
      "GGML_BUILD_EXAMPLES": "OFF",
      "WHISPER_USE_SYSTEM_GGML": "OFF",
      "WHISPER_BUILD_TESTS": "OFF",
      "WHISPER_BUILD_EXAMPLES": "ON",
      "WHISPER_BUILD_SERVER": "OFF",
      "WHISPER_CURL": "OFF",
      "WHISPER_SDL2": "OFF",
      "WHISPER_FFMPEG": "OFF",
      "WHISPER_COREML": "OFF",
      "WHISPER_COREML_ALLOW_FALLBACK": "OFF",
      "WHISPER_OPENVINO": "OFF"
    }
  }],
  "buildPresets": [{
    "name": "windows-x64-cpu",
    "configurePreset": "windows-x64-cpu",
    "configuration": "Release",
    "targets": ["whisper-cli"],
    "jobs": 2
  }]
}

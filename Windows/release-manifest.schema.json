    "hosting": {
      "type": "object",
      "required": [
        "report",
        "url",
        "releaseTag",
        "releaseId",
        "assetId",
        "immutableRelease",
        "downloadedAtUtc",
        "downloadedByteLength",
        "downloadedSha256",
        "browser",
        "os",
        "physical",
        "markOfTheWebZoneId",
        "smartScreen",
        "publisherDisplay",
        "reputationDisclosure",
        "detailReport"
      ],
      "additionalProperties": false,
      "properties": {
        "report": {
          "$ref": "#/$defs/reportRef"
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "releaseTag": {
          "type": "string",
          "minLength": 1
        },
        "releaseId": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "assetId": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "immutableRelease": {
          "const": true
        },
        "downloadedAtUtc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "downloadedByteLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "downloadedSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "browser": {
          "type": "string",
          "minLength": 1
        },
        "os": {
          "type": "object",
          "required": [

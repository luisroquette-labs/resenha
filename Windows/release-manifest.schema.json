                "Home",
                "Pro"
              ]
            },
            "release": {
              "enum": [
                "22H2",
                "25H2"
              ]
            },
            "build": {
              "type": "string",
              "pattern": "^10\\.0\\.(19045|26200)\\.[0-9]+$"
            },
            "architecture": {
              "const": "x64"
            }
          }
        },
        "physical": {
          "const": true
        },
        "markOfTheWebZoneId": {
          "const": 3
        },
        "smartScreen": {
          "enum": [
            "allowed",
            "reputation-warning"
          ]
        },
        "publisherDisplay": {
          "type": "string",
          "minLength": 1
        },
        "reputationDisclosure": {
          "type": "string"
        },
        "detailReport": {
          "$ref": "#/$defs/input"
        }
      }

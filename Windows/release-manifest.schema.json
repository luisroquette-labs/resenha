          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "verifiedAtUtc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "sourceCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "artifactSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "payloadInventorySha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "stage": {
          "enum": [
